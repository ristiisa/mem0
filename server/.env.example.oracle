# ---------------------------------------------------------------------------
# PRODUCTION on the Oracle ARM box as a Coolify "Docker Compose" application
# (server/docker-compose.oracle.yaml), served at example.com.
#   embedder = Ollama embeddinggemma-2 in the compose stack (CPU, ~121ms)
#   LLM      = 9router cc/claude-haiku (Anthropic-native /v1/messages), or the Mac's Ollama
# Set these as Coolify environment variables; never commit real values.
# ---------------------------------------------------------------------------

# --- Platform-compat (stock Claude Code plugin: `Authorization: Token <MEM0_API_KEY>`) ---
MEM0_PLATFORM_TOKEN=CHANGE_ME_long_random
MEM0_PLATFORM_USER_EMAIL=you@example.com

# --- Remote MCP (claude.ai connector: `Authorization: Bearer <MEM0_MCP_TOKEN>`) ---
MEM0_MCP_TOKEN=CHANGE_ME_long_random
# Must match the plugin's user_id (defaults to the local account name).
MEM0_MCP_USER_ID=CHANGE_ME_user

JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
POSTGRES_PASSWORD=CHANGE_ME_postgres

# --- Extraction LLM via 9router (cc = Claude subscription; must use the Anthropic-native API) ---
MEM0_LLM_PROVIDER=anthropic
MEM0_LLM_MODEL=cc/claude-haiku-4-5-20251001
MEM0_LLM_API_KEY=CHANGE_ME_9router_key
ANTHROPIC_BASE_URL=https://example.com
MEM0_LLM_BASE_URL=

# --- Alternative: the Mac's Ollama (needs a tunnel from Oracle to the Mac) ---
# MEM0_LLM_PROVIDER=ollama
# MEM0_LLM_MODEL=llama3.2:3b
# MEM0_LLM_BASE_URL=http://<tunnel>:11434
