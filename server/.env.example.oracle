# ---------------------------------------------------------------------------
# PRODUCTION on the Oracle ARM box (Linux aarch64) as a Coolify resource,
# served at example.com via Coolify/Traefik.
#   embedder = Ollama embeddinggemma-2 running LOCALLY on Oracle (CPU)
#   LLM      = REMOTE (Oracle CPU can't run a real LLM) -> Mac's Ollama or 9router
# ---------------------------------------------------------------------------

# --- Interface ---
PLATFORM_COMPAT=1
# (A future remote-MCP interface for claude.ai connectors would mount on this
#  same server, reuse get_memory_instance(), and use a STATIC bearer header --
#  no OAuth. Not built in this phase.)

# --- Platform-compat auth (plugin sends `Authorization: Token <MEM0_API_KEY>`) ---
MEM0_PLATFORM_TOKEN=CHANGE_ME_long_random
MEM0_PLATFORM_USER_EMAIL=you@example.com

# --- Native server auth ---
AUTH_DISABLED=false
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
MEM0_TELEMETRY=false

# --- App DB (SQLAlchemy) ---
APP_DB_NAME=mem0_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_COLLECTION_NAME=memories

# --- Embedder: local Ollama embeddinggemma-2 on the Oracle host (CPU, ~121ms) ---
MEM0_EMBEDDER_PROVIDER=ollama_prefixed
MEM0_EMBEDDER_MODEL=embeddinggemma-2:570m
MEM0_EMBEDDER_DIMS=768
# Reach the Oracle host's Ollama from inside the container. With Coolify/Docker,
# add `extra_hosts: ["host.docker.internal:host-gateway"]` or use the host IP.
MEM0_EMBEDDER_BASE_URL=http://host.docker.internal:11434

# --- Extraction LLM: REMOTE. Point at the Mac's Ollama over the network, or 9router. ---
MEM0_LLM_PROVIDER=ollama
MEM0_LLM_MODEL=qwen2.5:14b
MEM0_LLM_BASE_URL=https://ollama.your-mac-tunnel.example
MEM0_LLM_TEMPERATURE=0.2
