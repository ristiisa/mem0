# ---------------------------------------------------------------------------
# LOCAL TEST on the Mac (Apple Silicon). Both embedder AND extraction LLM point
# at the Mac's local Ollama (0.40.7). Use with docker-compose.local-ollama.yaml.
# ---------------------------------------------------------------------------

# --- Platform-compat layer (lets the STOCK mem0 Claude Code plugin connect) ---
PLATFORM_COMPAT=1
# The plugin sends `Authorization: Token <MEM0_API_KEY>`. Set the client's
# MEM0_API_KEY to this value.
MEM0_PLATFORM_TOKEN=local-test-token-change-me
MEM0_PLATFORM_USER_EMAIL=you@example.com

# --- Native server auth (compat layer has its own; keep JWT_SECRET valid) ---
AUTH_DISABLED=false
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
MEM0_TELEMETRY=false

# --- App DB (SQLAlchemy: users, api keys, platform_compat_events) ---
APP_DB_NAME=mem0_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Vector store DB (pgvector lives in the same instance, db "postgres")
POSTGRES_DB=postgres
POSTGRES_COLLECTION_NAME=memories

# --- Embedder: Ollama embeddinggemma-2:570m (768-dim, prefix wrapper) ---
MEM0_EMBEDDER_PROVIDER=ollama_prefixed
MEM0_EMBEDDER_MODEL=embeddinggemma-2:570m
MEM0_EMBEDDER_DIMS=768
MEM0_EMBEDDER_BASE_URL=http://host.docker.internal:11434
# Prefixes required by embeddinggemma (defaults shown; override only if needed):
# MEM0_EMBED_DOC_PREFIX=title: none | text:<space>
# MEM0_EMBED_QUERY_PREFIX=task: search result | query:<space>

# --- Extraction LLM: local Ollama (pick one you have pulled) ---
MEM0_LLM_PROVIDER=ollama
MEM0_LLM_MODEL=qwen2.5:14b
MEM0_LLM_BASE_URL=http://host.docker.internal:11434
MEM0_LLM_TEMPERATURE=0.2
